{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Jacqueb-1337/FantasyKingdomDefense-mods/blob/main/schemas/mod-manifest.schema.json",
  "title": "FKD Mod Manifest",
  "type": "object",
  "required": ["id", "name", "version", "entryClass"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "entryClass": { "type": "string", "minLength": 1 },
    "minimumCoreVersion": { "type": "string" },
    "minimumLoaderVersion": {
      "type": "string",
      "description": "Deprecated alias for minimumCoreVersion"
    },
    "minimumHookApi": { "type": "integer", "minimum": 1 },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string" },
          "minimumVersion": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "assets": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": true
}
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FKD Mod Manifest",
  "type": "object",
  "required": ["namespace", "id", "name", "version", "entryClass"],
  "properties": {
    "namespace": {"type":"string","pattern":"^[a-z0-9][a-z0-9._-]*$"},
    "id": {"type":"string","pattern":"^[a-z0-9][a-z0-9._-]*$"},
    "name": {"type":"string","minLength":1},
    "version": {"type":"string","minLength":1},
    "description": {"type":"string"},
    "entryClass": {"type":"string","minLength":1},
    "minimumCoreVersion": {"type":"string"},
    "minimumLoaderVersion": {"type":"string","description":"Deprecated alias for minimumCoreVersion"},
    "minimumHookApi": {"type":"integer","minimum":1},
    "dependencies": {
      "type":"array",
      "items":{
        "oneOf":[
          {
            "type":"object",
            "required":["type","minimumVersion"],
            "properties":{
              "type":{"const":"core"},
              "minimumVersion":{"type":"string","minLength":1},
              "repository":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]*$"}
            },
            "additionalProperties":false
          },
          {
            "type":"object",
            "required":["namespace","id"],
            "properties":{
              "type":{"type":"string","enum":["mod"]},
              "namespace":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]*$"},
              "id":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]*$"},
              "minimumVersion":{"type":"string"},
              "repository":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]*$"}
            },
            "additionalProperties":false
          }
        ]
      }
    },
    "assets":{"type":"array","items":{"type":"string"}}
  },
  "additionalProperties":true
}